# Required Provider API Keys
SERPER_API_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Optional Provider Configuration
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1

# Optional Pipeline Configuration
DISCOVERY_MODE=production

# MongoDB Storage (cache lookup + runs history). Leave empty to disable storage:
# the pipeline then falls through to a full run every time, and cache lookup is skipped.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=business_directory
